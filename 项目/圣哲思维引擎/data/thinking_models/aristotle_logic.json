  "核心概念": {
    "primary_concept": "形式逻辑",
    "concept_definition": "通过概念-判断-推理的严密逻辑链条，达到可靠的知识",
    "concept_explained": "亚里士多德是形式逻辑之父，创立了三段论等逻辑工具。他强调知识的确定性来源于严密的概念定义和逻辑推理。方法论：先定义概念，再进行推理，最终获得可靠结论。",
    "concept_level": ["入门-掌握基本逻辑", "理解-三段论推理", "运用-严密论证", "化境-逻辑思维"],
    "concept_keywords": ["三段论", "形式逻辑", "定义", "范畴", "矛盾律", "排中律", "中道"]
  },
  
  "思维流程": {
    "flow_name": "逻辑思维四步",
    "flow_type": "linear",
    "steps": [
      {
        "step_id": 1,
        "step_name": "界定",
        "description": "对概念进行严格定义，明确范畴",
        "question_prompt": "这个概念的本质属性是什么？属于哪个范畴？",
        "skill_focused": "概念定义",
        "common_pitfall": "概念模糊或歧义",
        "tip": "清晰的定义是严密推理的前提"
      },
      {
        "step_id": 2,
        "step_name": "判断",
        "description": "基于事实和证据形成判断命题",
        "question_prompt": "这个命题是真还是假？有什么证据支持？",
        "skill_focused": "命题判断",
        "common_pitfall": "基于情绪而非事实判断",
        "tip": "判断要有证据支撑"
      },
      {
        "step_id": 3,
        "step_name": "推理",
        "description": "通过三段论等形式进行逻辑推理",
        "question_prompt": "从前提能必然推出这个结论吗？推理是否有效？",
        "skill_focused": "逻辑推理",
        "common_pitfall": "推理跳跃或前提错误",
        "tip": "检查推理链条的每一环"
      },
      {
        "step_id": 4,
        "step_name": "验证",
        "description": "验证结论的正确性，检查矛盾",
        "question_prompt": "这个结论自洽吗？与其他真理矛盾吗？",
        "skill_focused": "逻辑验证",
        "common_pitfall": "忽略矛盾",
        "tip": "逻辑要求首尾一致"
      }
    ],
    "flow_summary": "界定 → 判断 → 推理 → 验证"
  },
  
