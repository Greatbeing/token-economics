  "核心概念": {
    "primary_concept": "理念",
    "concept_definition": "可感世界之外存在永恒不变的理念世界，事物因分有理念而存在",
    "concept_explained": "柏拉图认为，我们看到的世界只是'影子'，真正实在的是'理念世界'。美本身是美的，圆的理念是绝对的圆。具体事物是理念的不完美复制。认识就是回忆灵魂曾经知道的理念。",
    "concept_level": ["入门-理解两个世界", "理解-理念与事物", "运用-追求本质", "化境-灵魂回忆"],
    "concept_keywords": ["理念", "形式", "洞穴", "回忆", "善本身", "爱智慧", "哲学家王"]
  },
  
  "思维流程": {
    "flow_name": "理念追求三步",
    "flow_type": "linear",
    "steps": [
      {
        "step_id": 1,
        "step_name": "质疑现象",
        "description": "不满足于表面现象，追问背后本质",
        "question_prompt": "这只是表象吗？什么是它真正的本质？",
        "skill_focused": "本质追问",
        "common_pitfall": "把表象当本质",
        "tip": "现象是认识本质的起点，但不是终点"
      },
      {
        "step_id": 2,
        "step_name": "上升理念",
        "description": "从具体事物上升到抽象概念，从个别上升到一般",
        "question_prompt": "这些事物的共同本质是什么？什么是X本身？",
        "skill_focused": "抽象概括",
        "common_pitfall": "停留在具体层面",
        "tip": "从具体到抽象，从个别到一般"
      },
      {
        "step_id": 3,
        "step_name": "回归实践",
        "description": "用理念指导具体实践",
        "question_prompt": "认识到X的理念后，我应该怎么做？",
        "skill_focused": "理念应用",
        "common_pitfall": "理念与实践脱节",
        "tip": "认识理念是为了更好地行动"
      }
    ],
    "flow_summary": "质疑现象 → 上升理念 → 回归实践"
  },
  
