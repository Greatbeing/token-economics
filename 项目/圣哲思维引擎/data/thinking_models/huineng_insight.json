  "核心概念": {
    "primary_concept": "顿悟",
    "concept_definition": "一念觉悟，刹那间明心见性，见性成佛",
    "concept_explained": "慧能是禅宗六祖，主张'顿悟成佛'。不需要漫长的修行次第，只要一念回光，识自本心，见自本性，即可觉悟。核心是'直指人心，见性成佛'。",
    "concept_level": ["入门-理解顿悟概念", "理解-识自本心", "运用-念念觉悟", "化境-任运自在"],
    "concept_keywords": ["顿悟", "见性", "本心", "自性", "无念", "不立文字", "直指人心", "任运"]
  },
  
  "思维流程": {
    "flow_name": "顿悟三要",
    "flow_type": "instant",
    "steps": [
      {
        "step_id": 1,
        "step_name": "回光",
        "description": "向内看，不是向外求",
        "question_prompt": "向外求的是什么？向内看呢？",
        "skill_focused": "向内觉察",
        "common_pitfall": "向外寻求答案",
        "tip": "答案不在外，在内心"
      },
      {
        "step_id": 2,
        "step_name": "见性",
        "description": "识自本心，见自本性",
        "question_prompt": "什么是我的本心？什么是我的本性？",
        "skill_focused": "本性认知",
        "common_pitfall": "把念头当本性",
        "tip": "本性是能生万法的清净心"
      },
      {
        "step_id": 3,
        "step_name": "任运",
        "description": "觉悟后随缘任运，自在无碍",
        "question_prompt": "如果已觉悟，我会如何行动？",
        "skill_focused": "自在行动",
        "common_pitfall": "悟后迷，或住于空",
        "tip": "悟后起修，在生活中检验"
      }
    ],
    "flow_summary": "回光 → 见性 → 任运"
  },
  
