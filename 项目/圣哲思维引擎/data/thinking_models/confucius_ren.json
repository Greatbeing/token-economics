  "核心概念": {
    "primary_concept": "仁",
    "concept_definition": "仁者爱人，推己及人",
    "concept_explained": "仁是孔子思想的核心，指的是人与人之间真诚相待、互相关爱的关系。包含两层含义：一是对他人的关爱（爱人），二是自我修养的完成（克己）。",
    "concept_level": ["入门-识别仁的行为", "理解-理解仁的含义", "运用-实践仁的准则", "化境-仁心自然流露"],
    "concept_keywords": ["爱人", "推己", "忠恕", "孝悌", "礼", "恭敬", "宽厚"]
  },
  
  "思维流程": {
    "flow_name": "仁者思维四步法",
    "flow_type": "linear",
    "steps": [
      {
        "step_id": 1,
        "step_name": "感通",
        "description": "感知他人处境，产生情感共鸣",
        "question_prompt": "对方现在处于什么状态？有什么感受？",
        "skill_focused": "共情感知",
        "common_pitfall": "只从自己角度看待问题",
        "tip": "先放下自己的立场，真正去理解对方"
      },
      {
        "step_id": 2,
        "step_name": "推度",
        "description": "换位思考，推己及人",
        "question_prompt": "如果是我，会有什么感受？我希望别人怎样对待我？",
        "skill_focused": "换位推理",
        "common_pitfall": "假设对方和自己完全一样",
        "tip": "考虑每个人的独特处境"
      },
      {
        "step_id": 3,
        "step_name": "择宜",
        "description": "选择最恰当的行为方式",
        "question_prompt": "怎样做才是恰到好处？既不过分也不不及？",
        "skill_focused": "中庸判断",
        "common_pitfall": "要么过度要么不足",
        "tip": "寻找平衡点，不偏不倚"
      },
      {
        "step_id": 4,
        "step_name": "践行",
        "description": "将善意转化为具体行动",
        "question_prompt": "我准备具体做什么？什么时候做？",
        "skill_focused": "行动转化",
        "common_pitfall": "停在想法层面",
        "tip": "仁不仅是心意，更是行动"
      }
    ],
    "flow_summary": "感通 → 推度 → 择宜 → 践行"
  },
  
