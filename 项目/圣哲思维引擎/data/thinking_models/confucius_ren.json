  "经典语录": [
    {
      "quote": "己所不欲，勿施于人",
      "source": "《论语·颜渊》",
      "interpretation": "自己不愿意的，不要强加给别人。这是仁的消极表达。"
    },
    {
      "quote": "己欲立而立人，己欲达而达人",
      "source": "《论语·雍也》",
      "interpretation": "自己要站稳，也要让别人站稳；自己要通达，也要让别人通达。这是仁的积极表达。"
    },
    {
      "quote": "仁者爱人",
      "source": "《论语·颜渊》",
      "interpretation": "仁的本质就是关爱他人。"
    }
  ],
  
  "练习题模板": [
    {
      "template_id": "confucius_ren_001_p1",
      "template_name": "情境分析题",
      "template_type": "analysis",
      "difficulty": 2,
      "estimated_time": "10分钟",
      "prompt": "遇到以下情境，你会如何运用仁的思维？\n\n【情境】{scenario}\n\n请按四步法分析：\n1. 感通：各方有什么感受？\n2. 推度：如果是我会怎样？\n3. 择宜：什么是恰到好处的做法？\n4. 践行：我准备具体怎么做？"
    },
    {
      "template_id": "confucius_ren_001_p2",
      "template_name": "决策权衡题",
      "template_type": "decision",
      "difficulty": 3,
      "estimated_time": "15分钟",
      "prompt": "面对以下抉择，运用中庸思维进行分析：\n\n【情境】{scenario}\n\n请分析：\n1. 这个抉择涉及哪些人的利益和感受？\n2. 各种选择会导致什么后果？\n3. 找到'恰到好处'的平衡点是什么？"
    },
    {
      "template_id": "confucius_ren_001_p3",
      "template_name": "反思实践题",
      "template_type": "reflection",
      "difficulty": 2,
      "estimated_time": "10分钟",
      "prompt": "回顾你最近的一次人际互动：\n\n【情境】{scenario}\n\n反思：\n1. 你当时有'感通'对方的感受吗？\n2. 你有'推己及人'地思考吗？\n3. 你的处理方式是否'中庸'？\n4. 如果重来，你会如何'践行'？"
    }
  ],
  
