  "经典语录": [
    {
      "quote": "道可道，非常道",
      "source": "《道德经》第一章",
      "interpretation": "可以用语言说出来的'道'，就不是永恒不变的'道'。道是超越语言的。"
    },
    {
      "quote": "上善若水",
      "source": "《道德经》第八章",
      "interpretation": "最高的善就像水一样，水善利万物而不争。"
    },
    {
      "quote": "无为而无不为",
      "source": "《道德经》第三十七章",
      "interpretation": "顺应自然不妄为，反而没有什么事做不成。"
    },
    {
      "quote": "知人者智，自知者明",
      "source": "《道德经》第三十三章",
      "interpretation": "了解他人是智慧，了解自己才是真正的明智。"
    }
  ],
  
  "练习题模板": [
