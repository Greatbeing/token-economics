  "核心概念": {
    "primary_concept": "道",
    "concept_definition": "道法自然，无为而无不为",
    "concept_explained": "道是宇宙万物的根本规律，顺应道就是顺应自然规律做事。'无为'不是什么都不做，而是不违背自然规律地做事，看似无为实则无所不成。",
    "concept_level": ["入门-理解道的概念", "理解-体悟自然之理", "运用-顺应规律行事", "化境-与道合一"],
    "concept_keywords": ["道", "自然", "无为", "柔弱", "不争", "虚静", "返璞"]
  },
  
  "思维流程": {
    "flow_name": "道法思维三步法",
    "flow_type": "linear",
    "steps": [
      {
        "step_id": 1,
        "step_name": "观道",
        "description": "观察事物本来的样子和规律",
        "question_prompt": "这件事物的本来面目是什么？它的自然规律是什么？",
        "skill_focused": "本质观察",
        "common_pitfall": "被表象迷惑，加入过多主观判断",
        "tip": "像镜子一样如实反映，不增不减"
      },
      {
        "step_id": 2,
        "step_name": "顺势",
        "description": "顺应规律，找到事半功倍的方向",
        "question_prompt": "顺着这个规律，应该往哪个方向走？什么力量在推动？",
        "skill_focused": "趋势把握",
        "common_pitfall": "强行干预，违背规律",
        "tip": "站在风口上，猪也能飞——关键是看清风势"
      },
      {
        "step_id": 3,
        "step_name": "无为",
        "description": "不妄为，不过度干预，让事物自然发展",
        "question_prompt": "我需要做什么？我不需要做什么？哪些是画蛇添足？",
        "skill_focused": "节制判断",
        "common_pitfall": "把'无为'当借口什么都不做",
        "tip": "'无为'是不做违背规律的事，不是不做事"
      }
    ],
    "flow_summary": "观道 → 顺势 → 无为"
  },
  
