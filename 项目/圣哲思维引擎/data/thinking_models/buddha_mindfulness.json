  "核心概念": {
    "primary_concept": "四圣谛",
    "concept_definition": "苦、集、灭、道——人生的真相与解脱之道",
    "concept_explained": "佛陀的教导核心是四圣谛：人生本质是苦（苦谛），苦有原因（集谛），苦可以止息（灭谛），有止息的方法（道谛）。通过正念觉察、缘起智慧，达到涅槃解脱。",
    "concept_level": ["入门-四圣谛基础", "理解-缘起法则", "运用-正念觉察", "化境-涅槃寂静"],
    "concept_keywords": ["四圣谛", "正念", "缘起", "无常", "无我", "中道", "八正道", "止息"]
  },
  
  "思维流程": {
    "flow_name": "正念觉察四步",
    "flow_type": "cycle",
    "steps": [
      {
        "step_id": 1,
        "step_name": "止观",
        "description": "止息杂念，定心于当下",
        "question_prompt": "此刻我的身、心、境是什么状态？",
        "skill_focused": "专注觉察",
        "common_pitfall": "思绪纷飞无法专注",
        "tip": "像观察溪水流过一样，只是觉察，不评判"
      },
      {
        "step_id": 2,
        "step_name": "观照",
        "description": "如实观照身心现象的了别作用，不增不减",
        "question_prompt": "这个现象的本质是什么？它无常吗？它是我吗？",
        "skill_focused": "如实观照",
        "common_pitfall": "加入好恶评判",
        "tip": "如镜子般如实反映，不迎不拒"
      },
      {
        "step_id": 3,
        "step_name": "缘起",
        "description": "观照现象之间的因果关联",
        "question_prompt": "这个现象的原因是什么？它会导致什么结果？",
        "skill_focused": "因果观照",
        "common_pitfall": "只看表面不看深层",
        "tip": "一切现象都有原因，一切原因都有结果"
      },
      {
        "step_id": 4,
        "step_name": "中道",
        "description": "不落两极端，行于中道",
        "question_prompt": "什么是恰当的平衡点？我在走极端吗？",
        "skill_focused": "平衡把握",
        "common_pitfall": "非此即彼的思维",
        "tip": "避免纵欲和苦行，走中道"
      }
    ],
    "flow_summary": "止观 → 观照 → 缘起 → 中道（循环深入）"
  },
  
