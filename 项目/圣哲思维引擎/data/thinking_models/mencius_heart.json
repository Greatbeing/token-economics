  "核心概念": {
    "primary_concept": "性善",
    "concept_definition": "人皆有不忍人之心，恻隐之心人皆有之",
    "concept_explained": "孟子认为人的本性是善良的，每个人都有恻隐之心（同情心）、羞恶之心、辞让之心、是非之心，这是仁义礼智的萌芽。修养就是扩充培养这颗善心。",
    "concept_level": ["入门-认识四端之心", "理解-理解性善论", "运用-扩充善心", "化境-率性而为"],
    "concept_keywords": ["性善", "四端", "恻隐", "扩充", "养气", "大丈夫", "浩然之气"]
  },
  
  "思维流程": {
    "flow_name": "心性修养三步",
    "flow_type": "cycle",
    "steps": [
      {
        "step_id": 1,
        "step_name": "存心",
        "description": "觉察和存养自己的善心善念",
        "question_prompt": "此刻我的内心有什么感受？有什么善的冲动？",
        "skill_focused": "内在觉察",
        "common_pitfall": "忽略内心的声音",
        "tip": "善心稍纵即逝，要及时觉察和存养"
      },
      {
        "step_id": 2,
        "step_name": "扩充",
        "description": "将善心扩充到更广的范围和更深层次",
        "question_prompt": "这份善意可以扩展到谁？扩展到什么程度？",
        "skill_focused": "善心扩展",
        "common_pitfall": "只在小事上善良",
        "tip": "善心要不断扩充，从小及大，从近及远"
      },
      {
        "step_id": 3,
        "step_name": "养气",
        "description": "培养浩然之气，正气充盈",
        "question_prompt": "我的行为是否光明正大？是否俯仰无愧？",
        "skill_focused": "正气培养",
        "common_pitfall": "做事不光明磊落",
        "tip": "浩然之气需要集义而生，不是一蹴而就"
      }
    ],
    "flow_summary": "存心 → 扩充 → 养气（循环提升）"
  },
  
