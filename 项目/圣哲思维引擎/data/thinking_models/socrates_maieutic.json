    "model_name": "产婆术",
    "model_name_en": "Maieutic Method"
  },
  
  "核心概念": {
    "primary_concept": "产婆术",
    "concept_definition": "通过对话问答，帮助他人发现自己心中的真理",
    "concept_explained": "苏格拉底把自己比作助产士，他的任务不是传授知识，而是通过提问帮助对话者'产下'他们心中已有的知识。核心是通过追问让隐藏的谬误暴露，让真理自然显现。",
    "concept_level": ["入门-学会提问", "理解-追问方法", "运用-引导思考", "化境-助人觉悟"],
    "concept_keywords": ["产婆术", "追问", "自知其无知", "认识你自己", "德性即知识", "审视生活"]
  },
  
  "思维流程": {
    "flow_name": "产婆术七步法",
    "flow_type": "branch",
    "steps": [
      {
        "step_id": 1,
        "step_name": "质疑",
        "description": "对习以为常的观点提出质疑",
        "question_prompt": "这个观点真的正确吗？有什么证据？",
        "skill_focused": "批判性思维",
        "common_pitfall": "不假思索接受观点",
        "tip": "一切观点都值得审视"
      },
      {
        "step_id": 2,
        "step_name": "定义",
        "description": "澄清概念的含义",
        "question_prompt": "你说的'X'是什么意思？能给它下个定义吗？",
        "skill_focused": "概念澄清",
        "common_pitfall": "概念模糊却自以为理解",
        "tip": "清晰的定义是讨论的基础"
      },
      {
        "step_id": 3,
        "step_name": "举例",
        "description": "通过具体例子检验定义",
        "question_prompt": "能举个X的例子吗？什么不是X？",
        "skill_focused": "举例验证",
        "common_pitfall": "假设定义涵盖一切情况",
        "tip": "例子是检验概念的最佳工具"
      },
      {
        "step_id": 4,
        "step_name": "追问",
        "description": "连续追问，暴露矛盾",
        "question_prompt": "那为什么？这样不会导致矛盾吗？",
        "skill_focused": "逻辑追问",
        "common_pitfall": "浅尝辄止不敢深入",
        "tip": "真理越辩越明"
      },
      {
        "step_id": 5,
        "step_name": "归谬",
        "description": "将观点推向极端，发现谬误",
        "question_prompt": "按你的逻辑，那岂不是说...？",
        "skill_focused": "归谬法",
        "common_pitfall": "不敢承认错误",
        "tip": "承认无知是智慧的开始"
      },
      {
        "step_id": 6,
        "step_name": "反思",
        "description": "反思自己的认知局限",
        "question_prompt": "我们真正知道什么？我们的无知边界在哪里？",
        "skill_focused": "元认知",
        "common_pitfall": "以为自己什么都知道",
        "tip": "自知其无知"
      },
      {
        "step_id": 7,
        "step_name": "觉悟",
        "description": "通过自身思考获得真知",
        "question_prompt": "经过这一番讨论，你自己得出什么结论？",
        "skill_focused": "自我觉悟",
        "common_pitfall": "等待他人给答案",
        "tip": "真理需要自己发现"
      }
    ],
    "flow_summary": "质疑 → 定义 → 举例 → 追问 → 归谬 → 反思 → 觉悟"
  },
  
  "可复刻技能": [
